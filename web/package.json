{
  "name": "pinchora-web",
  "private": true,
  "version": "0.1.0",
  "description": "Pinchora's web dashboard (Vite + React SPA, embedded into the Rust binary).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "npm run build && node scripts/check-main.mjs && npm run reef:budget",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "reef:assets": "python3 scripts/build-reef.py",
    "prebuild": "npm run reef:assets",
    "predev": "npm run reef:assets",
    "e2e:reef": "playwright test --config playwright.reef.config.ts",
    "reef:budget": "node scripts/measure-reef.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.106.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
