# Pinchora configuration. Copy to `.env` (gitignored) and fill in.
#
#   cp .env.example .env
#
# Every variable is read with the PINCHORA_ prefix; `__` separates config sections
# (PINCHORA_DISCORD__TOKEN -> discord.token). Values below are placeholders only.
#
# docker compose reads this file for the app services. DATABASE__URL and REDIS__URL
# are overridden there to point at the compose containers, so the localhost URLs
# below only matter when you run the binary directly (`cargo run -p pinchora -- gateway`).

# --- Discord ------------------------------------------------------------------------

# Bot token from the Developer Portal (Bot -> Reset Token). Secret.
PINCHORA_DISCORD__TOKEN=replace-with-bot-token

# Application ID (General Information).
PINCHORA_DISCORD__APPLICATION_ID=123456789012345678

# Hex Ed25519 public key (General Information). Only needed by `pinchora interactions`,
# which verifies the signature of every incoming request with it.
# PINCHORA_DISCORD__PUBLIC_KEY=replace-with-hex-public-key

# Address of a twilight http-proxy, so every pod shares one REST ratelimit view.
# In docker compose the `http-proxy` service listens on http-proxy:3000.
# Leave unset to talk to Discord directly.
# PINCHORA_DISCORD__HTTP_PROXY=http-proxy:3000

# Register slash commands to this guild only (they update instantly while developing).
# `pinchora register --global` ignores it.
# PINCHORA_DISCORD__DEV_GUILD_ID=123456789012345678

# --- Gateway ------------------------------------------------------------------------

# Total shards across ALL clusters. REQUIRED when CLUSTER_COUNT > 1 so every pod
# agrees on the total; with one cluster it defaults to Discord's recommendation.
# Keep it fixed and a multiple of the bot's max_concurrency; changing it reshards.
# PINCHORA_GATEWAY__SHARDS=16

# Number of gateway clusters (pods). Must equal the StatefulSet replica count.
PINCHORA_GATEWAY__CLUSTER_COUNT=1

# This cluster's index, 0..CLUSTER_COUNT-1. Normally unset: it is parsed from the
# HOSTNAME suffix (pinchora-gateway-2 -> 2), i.e. the StatefulSet ordinal.
# PINCHORA_GATEWAY__CLUSTER_ID=0

# Listen for GUILD_MEMBER_ADD (privileged "Server Members" intent) for welcome cards.
# Set to false if the intent is not enabled for the application.
PINCHORA_GATEWAY__MEMBER_EVENTS=true

# --- HTTP servers -------------------------------------------------------------------

# Interactions endpoint (`pinchora interactions`): POST /interactions, GET /healthz.
# PINCHORA_INTERACTIONS__BIND=0.0.0.0:8080

# Ops server (every serving process): /metrics, /healthz (liveness), /readyz (readiness).
# PINCHORA_OPS__BIND=0.0.0.0:9000

# --- Web dashboard (`pinchora web`, the `web` compose service) -----------------------

# OAuth2 client secret (Developer Portal -> OAuth2 -> Client Secret). Secret. Without it the
# dashboard serves a setup page instead of "Log in with Discord".
PINCHORA_WEB__CLIENT_SECRET=replace-with-oauth-client-secret

# Where browsers reach the dashboard. Register <PUBLIC_URL>/auth/callback under
# Developer Portal -> OAuth2 -> Redirects (e.g. http://localhost:8090/auth/callback).
# PINCHORA_WEB__PUBLIC_URL=http://localhost:8090

# OAuth2 client id; defaults to PINCHORA_DISCORD__APPLICATION_ID.
# PINCHORA_WEB__CLIENT_ID=123456789012345678

# Listen address of `pinchora web`.
# PINCHORA_WEB__BIND=0.0.0.0:8090

# Mark cookies Secure; defaults to true when PUBLIC_URL is https.
# PINCHORA_WEB__COOKIE_SECURE=false

# Serve the SPA from a folder instead of the copy built into the binary (UI work).
# PINCHORA_WEB__STATIC_DIR=web/dist

# Discord's REST base; tests point it at a mock.
# PINCHORA_WEB__DISCORD_API_BASE=https://discord.com/api/v10

# Reverse proxies in front of the dashboard (comma-separated addresses or CIDR ranges). Only these
# may name the client with X-Forwarded-For; the login rate limit then counts each client, not the proxy.
# PINCHORA_WEB__TRUSTED_PROXIES=172.16.0.0/12

# Tests only: POST /auth/dev-login signs in as anyone without Discord. Ignored unless
# PINCHORA_WEB__BIND is a loopback address, and always in release builds (the Docker image).
# PINCHORA_WEB__DEV_LOGIN=false

# --- Postgres -----------------------------------------------------------------------

# Secret. In compose this is overridden with the postgres container.
PINCHORA_DATABASE__URL=postgres://pinchora:replace-with-password@localhost:5432/pinchora
# PINCHORA_DATABASE__MAX_CONNECTIONS=20

# --- Redis --------------------------------------------------------------------------

# Secret when it carries a password. In compose this is overridden with the redis container.
PINCHORA_REDIS__URL=redis://localhost:6379
# PINCHORA_REDIS__POOL_SIZE=4

# --- Logging ------------------------------------------------------------------------

# pretty (human, local) or json (one object per line, for log shippers).
PINCHORA_LOG__FORMAT=pretty
# PINCHORA_LOG__FILTER=info,pinchora=debug
# RUST_LOG also works and takes the same syntax.

# --- docker compose only ------------------------------------------------------------

# Password of the compose postgres container (also used in the DATABASE__URL override).
POSTGRES_PASSWORD=replace-with-password

# Host ports published on 127.0.0.1; change them if 5432 / 6379 / 8090 are already taken.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# WEB_PORT=8090

# --- Tests --------------------------------------------------------------------------

# Integration tests are skipped unless these are set. Point them at throwaway
# databases (`docker compose up -d postgres redis` publishes the ports below).
# PINCHORA_TEST_DATABASE_URL=postgres://pinchora:replace-with-password@localhost:5432/pinchora
# PINCHORA_TEST_REDIS_URL=redis://localhost:6379
