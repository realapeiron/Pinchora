# Copy to `secrets.env` (gitignored) and fill in:
#
#   cp secrets.env.example secrets.env
#
# kustomize turns it into the `pinchora-secrets` Secret. Lines are KEY=value,
# no quotes. Never commit the real file.

# Bot token from the Developer Portal. Also read by pinchora-http-proxy.
PINCHORA_DISCORD__TOKEN=replace-with-bot-token

# Not secret, but specific to your application, so they live here with the rest.
PINCHORA_DISCORD__APPLICATION_ID=123456789012345678
# Hex Ed25519 public key; the interactions endpoint verifies request signatures with it.
PINCHORA_DISCORD__PUBLIC_KEY=replace-with-hex-public-key

# Postgres and Redis. The dev overlay overrides both with its in-cluster instances,
# so for dev these two lines can stay as they are.
PINCHORA_DATABASE__URL=postgres://pinchora:replace-with-password@postgres.example.internal:5432/pinchora?sslmode=require
PINCHORA_REDIS__URL=redis://redis.example.internal:6379
